{
  "name": "korkollie-business-center",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing website for Korkollie Business Center — printing, branding and business services in Paynesville, Liberia.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch",
    "serve": "python3 -m http.server 8000",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
